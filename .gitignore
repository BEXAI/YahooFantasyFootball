# Runtime state — never commit. Patterns are ROOT-ANCHORED (leading /):
# an unanchored "lineup.json" would also ignore the TRACKED advice/lineup.json
# and silently kill the research-layer data channel.
profile/
PAUSED
/lineup.json
/config.json
/advice_remote.json

# Generated artifacts
logs/*
!logs/.gitkeep
screenshots/*
!screenshots/.gitkeep

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
